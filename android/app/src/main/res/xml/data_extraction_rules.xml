<?xml version="1.0" encoding="utf-8"?>
<!-- Credentials are encrypted with a Keystore key that is never backed up or
     transferred, so the encrypted file is excluded too. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
